{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "harness_validate",
      "argv": ["python3", "scripts/check_harness.py"],
      "cwd": ".",
      "timeoutSeconds": 10,
      "required": true
    }
  ],
  "fingerprintPaths": [
    "AGENTS.md",
    "README.md",
    "pyproject.toml",
    "scripts/harness.py",
    "scripts/check_harness.py",
    "docs/GOALS.md",
    "docs/PLANS.md",
    "docs/ARCHITECTURE.md",
    "docs/RELIABILITY.md",
    "docs/SECURITY.md",
    "docs/config.json",
    "docs/tasks.json"
  ],
  "delivery": {
    "required": false,
    "provider": "local"
  }
}
